# Copy the relevant keys into web/.env.local and worker/.env for local development.
# Local values come from `supabase status` after `supabase start`. Never commit real keys.

# --- web/.env.local ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=fake-anon-key
SUPABASE_SERVICE_ROLE_KEY=fake-service-role-key
NEXT_PUBLIC_WORKER_URL=http://127.0.0.1:8000

# --- worker/.env ---
SUPABASE_URL=http://127.0.0.1:54341
SUPABASE_SERVICE_ROLE_KEY=fake-service-role-key

# Provider-agnostic AI gateway. Local dev must default to ollama so the build
# never blocks on a rate limit. Never hardcode a provider in feature code.
AI_PROVIDER=ollama|gemini|groq

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

GEMINI_API_KEY=fake-gemini-key
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=fake-groq-key
GROQ_MODEL=llama-3.1-8b-instant

# --- production only (Phase 6) ---
# Data residency: Supabase region ap-south-1 (Mumbai).
